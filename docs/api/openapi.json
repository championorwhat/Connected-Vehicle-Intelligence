            "format": "uuid",
            "title": "Vehicle Id",
            "type": "string"
          },
          "workshop_id": {
            "format": "uuid",
            "title": "Workshop Id",
            "type": "string"
          }
        },
        "required": [
          "vehicle_id",
          "failure_mode",
          "workshop_id"
        ],
        "title": "CreateWorkOrder",
        "type": "object"
      },
      "ErasureRequest": {
        "properties": {
