{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prognos.local/schemas/fleet-signal-v1.schema.json",
  "title": "Emerging-fault fleet signal v1 (topic fleet.signals)",
  "description": "A DTC that is significantly more common in one cohort (model/firmware) than in its baseline, over one event-time window. Aggregate only: no vehicle or tenant identifiers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "signal_type", "level", "dtc", "oem", "model_code", "firmware_version",
               "powertrain", "window_start", "window_end", "affected_vehicles", "cohort_vehicles", "rate",
               "baseline", "baseline_affected", "baseline_vehicles", "baseline_rate", "rate_ratio",
               "p_value", "p_adjusted", "tests_in_window"],
  "properties": {
    "schema_version": {"const": 1},
    "signal_type": {"const": "EMERGING_DTC"},
    "level": {"enum": ["firmware", "model"], "description": "firmware: vs same model, other firmware; model: vs other models with the same powertrain"},
    "dtc": {"type": "string", "pattern": "^[PCBU][0-9A-F]{4}$"},
    "oem": {"type": "string", "minLength": 1},
    "model_code": {"type": "string", "pattern": "^[A-HJ-NPR-Z0-9]{5}$"},
    "firmware_version": {"type": ["string", "null"], "description": "null for model-level signals"},
    "powertrain": {"enum": ["ICE", "HEV", "BEV"]},
    "window_start": {"type": "number", "description": "epoch seconds (event time)"},
    "window_end": {"type": "number"},
    "affected_vehicles": {"type": "integer", "minimum": 1},
    "cohort_vehicles": {"type": "integer", "minimum": 1},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "baseline": {"type": "string"},
    "baseline_affected": {"type": "integer", "minimum": 0},
    "baseline_vehicles": {"type": "integer", "minimum": 1},
    "baseline_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "rate_ratio": {"type": "number", "minimum": 0},
    "p_value": {"type": "number", "minimum": 0, "maximum": 1},
    "p_adjusted": {"type": "number", "minimum": 0, "maximum": 1, "description": "Bonferroni over tests_in_window"},
    "tests_in_window": {"type": "integer", "minimum": 1}
  }
}
