{
  // GitHub Codespaces / VS Code Dev Containers: the full stack (Kafka, PostgreSQL, ClickHouse,
  // Redis, pipeline, API, dashboard) runs in Docker inside the container. See README "Run it
  // in GitHub Codespaces".
  "name": "Prognos",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  // The stack needs about 5 GB; 4 cores / 16 GB is the smallest machine that runs the demo.
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080, 8000, 3000, 9090],
  "portsAttributes": {
    "8080": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "8000": { "label": "API (OpenAPI at /docs)", "onAutoForward": "silent" },
    "3000": { "label": "Grafana", "onAutoForward": "silent" },
    "9090": { "label": "Prometheus", "onAutoForward": "silent" }
  },
  "otherPortsAttributes": { "onAutoForward": "ignore" },
  "customizations": {
    "vscode": {
      "extensions": [
        "charliermarsh.ruff",
        "ms-python.python",
        "ms-python.mypy-type-checker",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
