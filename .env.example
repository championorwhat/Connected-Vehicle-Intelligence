# =============================================================================
# Prognos — environment configuration
# Copy to .env (`make env`) and adjust. Never commit .env.
# Defaults below are sized for an 8 GB laptop (the "laptop" scale profile).
# Values marked [scale] are raised for the 100K-vehicle runs.
# =============================================================================

# --- Project -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=prognos
ENVIRONMENT=local
LOG_LEVEL=INFO

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=kafka:19092
# Host-side port for tools running on your Mac (outside Docker)
KAFKA_HOST_PORT=9092
KAFKA_HEAP_OPTS="-Xms512m -Xmx512m"
# [scale] 24 partitions for 100K vehicles; 6 is enough locally
KAFKA_TELEMETRY_PARTITIONS=6
# 1 locally (single broker); 3 with the HA overlay (infra/docker/compose.kafka-ha.yml)
KAFKA_REPLICATION_FACTOR=1
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_TELEMETRY_RETENTION_MS=86400000

# --- PostgreSQL (transactional / relational core) ----------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
POSTGRES_DB=prognos
POSTGRES_USER=prognos
# Local-only placeholder. Real deployments inject secrets from a vault.
POSTGRES_PASSWORD=change-me-local-only

# --- ClickHouse (telemetry / analytics) --------------------------------------
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
CLICKHOUSE_DB=telemetry
CLICKHOUSE_USER=prognos
CLICKHOUSE_PASSWORD=change-me-local-only

# --- Redis (latest state, dedup windows, rate limits, pub/sub) ---------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_HOST_PORT=6379
REDIS_MAXMEMORY=256mb

# --- Object storage for Parquet (warm/cold tier, training sets) --------------
# file:// locally; s3://bucket/prefix or gs://bucket/prefix in cloud (config-only change)
OBJECT_STORE_URL=file:///data/lake

# --- Simulator ---------------------------------------------------------------
# [scale] VEHICLE_COUNT=100000, EVENTS_PER_SECOND=100000
VEHICLE_COUNT=10000
EVENTS_PER_SECOND=10000
SIM_WORKERS=2
BURST_MULTIPLIER=3
# Seconds after start when the burst begins; -1 = no burst. The brief's test: 3x for 300 s.
BURST_START_SECONDS=-1
BURST_DURATION_SECONDS=300
DUPLICATE_RATE=0.01
OUT_OF_ORDER_RATE=0.02
MALFORMED_RATE=0.005
MISSING_FIELD_RATE=0.01
# Fraction of eligible vehicles degrading at any time
FAULT_RATE=0.01
# >1 compresses degradation timelines (1440 => a 1-day degradation takes 1 minute)
FAULT_TIME_SCALE=1
# "demo": 5 vehicles (one per failure mode) fail 10-18 minutes after start
SIM_SCENARIO=none
TENANT_COUNT=20
SIM_SEED=42
SIM_METRICS_HOST_PORT=9101

# --- Normalizer (stream processor) -------------------------------------------
# Consumer processes in the "normalizer" group; at most the raw topic's partition count.
NORMALIZER_REPLICAS=2
NORMALIZER_BATCH_SIZE=2000
REGISTRY_REFRESH_SECONDS=300

# --- Detector (stream processor) ---------------------------------------------
DETECTOR_REPLICAS=1
DETECTOR_BATCH_SIZE=2000
# Seconds of event time between vehicle.state snapshots per vehicle
STATE_INTERVAL_SECONDS=15

# --- Sink (PostgreSQL alerts + Redis live state) -------------------------------
# How long to retry a database/Redis outage before exiting (Kafka then re-delivers)
SINK_RETRY_BUDGET_SECONDS=60

# --- Observability -----------------------------------------------------------
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only

# --- Builds ------------------------------------------------------------------
# Only behind a TLS-intercepting proxy: path to a CA bundle trusted during image builds.
EXTRA_CA_FILE=
