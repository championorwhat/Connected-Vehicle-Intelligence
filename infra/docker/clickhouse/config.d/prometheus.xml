<!-- Built-in Prometheus endpoint (no exporter container): server metrics, events and
     async metrics at http://clickhouse:9363/metrics, scraped by the `clickhouse` job. -->
<clickhouse>
    <prometheus>
        <endpoint>/metrics</endpoint>
        <port>9363</port>
        <metrics>true</metrics>
        <events>true</events>
        <asynchronous_metrics>true</asynchronous_metrics>
    </prometheus>
</clickhouse>
