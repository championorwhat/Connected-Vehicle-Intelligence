<!-- Keeps ClickHouse inside a ~1.5 GB container on small laptops.
     Raise these for the 100K-vehicle scale runs. -->
<clickhouse>
    <max_server_memory_usage_to_ram_ratio>0.75</max_server_memory_usage_to_ram_ratio>
    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>
    <max_concurrent_queries>50</max_concurrent_queries>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <!-- Disable noisy system log tables that consume memory and disk locally -->
    <asynchronous_metric_log remove="1"/>
    <metric_log remove="1"/>
    <trace_log remove="1"/>
    <text_log remove="1"/>
    <latency_log remove="1"/>
</clickhouse>
